{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/gcs/rolling-paper-2026",
      "destination": "/api/gcs-proxy"
    },
    {
      "source": "/api/auth/github/url",
      "destination": "/api/github-url"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
